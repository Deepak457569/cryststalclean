# Cloudflare & CrystalClean Environment Configuration Template
# NOTE: Do NOT store sensitive secrets in this file. In Cloudflare Workers,
# store production secrets using: npx wrangler secret put <SECRET_NAME>

# Application
VITE_API_BASE_URL=/api
VITE_WHATSAPP_NUMBER=919149953610

# Cloudflare D1
CLOUDFLARE_DATABASE_ID=your-d1-database-uuid

# Initial Admin Account
INITIAL_ADMIN_EMAIL=admin@crystalclean.in
ADMIN_ALLOWLIST=admin@crystalclean.in,owner@crystalclean.in

# Authentication Secrets (Set via: wrangler secret put JWT_SECRET)
JWT_SECRET=your_super_secret_jwt_key_here

# Google OAuth 2.0 Credentials (From Google Cloud Console)
# Redirect URI: https://your-domain.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
