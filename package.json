{
  "name": "cryststalclean",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "node --test tests/acceptance.test.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "d1:init:local": "wrangler d1 execute DB --local --file=./migrations/0001_initial_schema.sql && wrangler d1 execute DB --local --file=./migrations/0002_seed_data.sql",
    "d1:init:remote": "wrangler d1 execute DB --remote --file=./migrations/0001_initial_schema.sql && wrangler d1 execute DB --remote --file=./migrations/0002_seed_data.sql"
  },
  "dependencies": {
    "lucide-react": "^1.55.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261011.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.149.0"
  }
}
